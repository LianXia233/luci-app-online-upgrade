#!/bin/sh
# Auto-reinstall luci-app-online-upgrade after sysupgrade.
# Kept across firmware upgrades via /lib/upgrade/keep.d/.
#
# 设计约束：不猜测。找不到与「本机包管理器 + 本机架构」匹配的安装包时明确报错，
# 不再回落成「取第一个包」——那会把错误架构的装到设备上。
# 任何一步失败都会写 logger 并让脚本以非零码退出，便于事后排查。

[ -x /usr/bin/online-upgrade ] && exit 0

FAIL=0
log() { logger -t "online-upgrade" "$*"; }
err() { logger -t "online-upgrade" "错误: $*"; FAIL=1; }

# ---- 包管理器与架构 ---------------------------------------------------------
PKG_MGR=""
ARCH=""
if command -v apk >/dev/null 2>&1; then
	PKG_MGR="apk"
	ARCH=$(apk --print-arch 2>/dev/null)
elif command -v opkg >/dev/null 2>&1; then
	PKG_MGR="opkg"
	ARCH=$(opkg print-architecture 2>/dev/null | awk '$1 == "arch" { print $2 }' | grep -v '^all$' | head -1)
fi

if [ -z "$PKG_MGR" ]; then
	err "本机既没有 apk 也没有 opkg，无法自动重装"
	exit $FAIL
fi

[ -z "$ARCH" ] && ARCH=$(uname -m)
# musl 架构名形如 aarch64_cortex-a53，仅取家族前缀参与匹配，避免把具体 CPU
# 型号写死；资产名里家族前缀可能写作 aarch64 / x86_64 / x86-64 等都算命中。
ARCH_FAMILY=$(printf '%s' "$ARCH" | cut -d_ -f1)
EXT="apk"
[ "$PKG_MGR" = "opkg" ] && EXT="ipk"

log "插件缺失，开始自动重装 (包管理器 $PKG_MGR, 架构 $ARCH, 家族 $ARCH_FAMILY)"

# ---- 1. 按备份的软件包清单恢复 ---------------------------------------------
if [ -f /root/.pkg-list.txt ]; then
	log "尝试按 /root/.pkg-list.txt 恢复软件包"
	while read -r pkg; do
		[ -z "$pkg" ] && continue
		if [ "$PKG_MGR" = "apk" ]; then
			apk info -e "$pkg" >/dev/null 2>&1 && continue
			out=$(apk add "$pkg" 2>&1)
			rc=$?
		else
			opkg list-installed 2>/dev/null | grep -q "^${pkg} " && continue
			out=$(opkg install "$pkg" 2>&1)
			rc=$?
		fi
		if [ $rc -eq 0 ]; then
			log "已安装: $pkg"
		else
			err "安装 $pkg 失败: $(printf '%s' "$out" | tail -2 | tr '\n' ' ')"
		fi
	done < /root/.pkg-list.txt
fi

if [ -x /usr/bin/online-upgrade ]; then
	rm -f /root/.pkg-list.txt
	log "插件已通过包清单恢复，跳过 Release 下载"
	exit $FAIL
fi

# ---- 2. 从 GitHub Release 下载安装包 ---------------------------------------
REPO=$(uci -q get online-upgrade.settings.plugin_repo)
[ -z "$REPO" ] && REPO="LianXia233/luci-app-online-upgrade"

# 镜像前缀归一化：后端会把前缀直接拼在地址前，缺结尾斜杠会拼成
# "https://hosthttps://..."，这里统一补一个。
PROXY=$(uci -q get online-upgrade.settings.proxy)
if [ -n "$PROXY" ]; then
	while [ "${PROXY%/}" != "$PROXY" ]; do PROXY="${PROXY%/}"; done
	PROXY="${PROXY}/"
	case "$PROXY" in
		http://*|https://*) ;;
		*) err "代理地址不合法，已忽略: $PROXY"; PROXY="" ;;
	esac
fi

if [ "$FAIL" -ne 0 ]; then
	log "上一步已出错，但继续尝试从 Release 安装"
fi

if ! command -v curl >/dev/null 2>&1; then
	err "缺少 curl，无法下载安装包"
	rm -f /root/.pkg-list.txt
	exit $FAIL
fi

RELEASE_JSON=$(curl -sL --connect-timeout 10 --max-time 40 \
	"https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null)
if [ -z "$RELEASE_JSON" ]; then
	err "无法获取 ${REPO} 的最新 Release（网络不可达或仓库不存在）"
	rm -f /root/.pkg-list.txt
	exit $FAIL
fi

ASSET_LIST=""
if command -v jsonfilter >/dev/null 2>&1; then
	ASSET_LIST=$(printf '%s' "$RELEASE_JSON" | jsonfilter -e '@.assets[*].browser_download_url' 2>/dev/null)
fi
if [ -z "$ASSET_LIST" ]; then
	# jsonfilter 缺失（精简固件常见）时的等效提取，不能把「没有 jsonfilter」
	# 当成「Release 里没有资产」而静默跳过。
	ASSET_LIST=$(printf '%s' "$RELEASE_JSON" | grep -o '"browser_download_url":"[^"]*"' | sed 's/.*:"//; s/"$//')
fi

if [ -z "$ASSET_LIST" ]; then
	err "Release 正文里没有可用的资产下载地址"
	rm -f /root/.pkg-list.txt
	exit $FAIL
fi

ASSET_RE="[^/]*${ARCH_FAMILY}[^/]*\\.${EXT}$"
CAND=$(printf '%s\n' "$ASSET_LIST" | grep -E "$ASSET_RE")
if [ -z "$CAND" ]; then
	TOTAL=$(printf '%s\n' "$ASSET_LIST" | grep -cE "\\.${EXT}$")
	if [ "$TOTAL" -eq 1 ]; then
		CAND=$(printf '%s\n' "$ASSET_LIST" | grep -E "\\.${EXT}$")
		log "没有资产名声明架构 ${ARCH}，但该 Release 只有一个 .${EXT}，按唯一候选处理"
	else
		err "在 ${REPO} 的最新 Release 里找不到声明本机架构 ${ARCH} 的 .${EXT}（共 ${TOTAL} 个同格式资产）"
		rm -f /root/.pkg-list.txt
		exit $FAIL
	fi
fi

CAND_N=$(printf '%s\n' "$CAND" | grep -c .)
PKG_URL=$(printf '%s\n' "$CAND" | head -1)
if [ "$CAND_N" -gt 1 ]; then
	# 开机恢复阶段没有交互界面可让用户选择，明确记录全部候选再取第一个，
	# 而不是悄悄取第一个。
	log "有 ${CAND_N} 个资产同时匹配架构 ${ARCH}，按顺序取第一个: $(printf '%s' "$CAND" | tr '\n' ' ')"
fi

TMP="/tmp/$(basename "$PKG_URL")"
DL_OK=0
if [ -n "$PROXY" ]; then
	curl -fsSL --connect-timeout 30 --max-time 600 -o "$TMP" "${PROXY}${PKG_URL}" 2>/dev/null
	[ -s "$TMP" ] && DL_OK=1
	if [ "$DL_OK" -eq 0 ]; then
		log "镜像下载失败，回退直连: $PKG_URL"
	fi
fi
if [ "$DL_OK" -eq 0 ]; then
	curl -fsSL --connect-timeout 30 --max-time 600 -o "$TMP" "$PKG_URL" 2>/dev/null
	[ -s "$TMP" ] && DL_OK=1
fi

if [ "$DL_OK" -eq 0 ]; then
	err "下载安装包失败: $PKG_URL"
	rm -f "$TMP" /root/.pkg-list.txt
	exit $FAIL
fi

if [ "$PKG_MGR" = "apk" ]; then
	out=$(apk add --allow-untrusted "$TMP" 2>&1)
	rc=$?
else
	out=$(opkg install "$TMP" 2>&1)
	rc=$?
fi
rm -f "$TMP"
rm -f /root/.pkg-list.txt

if [ $rc -ne 0 ]; then
	err "安装失败($PKG_MGR): $(printf '%s' "$out" | tail -3 | tr '\n' ' ')"
	exit $FAIL
fi
if [ ! -x /usr/bin/online-upgrade ]; then
	err "安装命令返回成功，但 /usr/bin/online-upgrade 仍不可执行"
	exit $FAIL
fi

log "自动重装成功"
exit $FAIL
