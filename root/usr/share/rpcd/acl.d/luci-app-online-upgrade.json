{
	"luci-app-online-upgrade": {
		"description": "Grant access to LuCI app online-upgrade",
		"read": {
			"ubus": {
				"luci.online-upgrade": [ "get_status", "get_log", "list_backups", "get_config", "get_sysinfo", "probe_assets" ]
			},
			"cgi-io": [ "download" ],
			"file": {
				"/root/pre-upgrade-backup-*": [ "read" ]
			},
			"uci": [ "online-upgrade" ]
		},
		"write": {
			"ubus": {
				"luci.online-upgrade": [ "check", "start_upgrade", "backup", "restore", "set_config", "delete_backup" ]
			},
			"cgi-io": [ "upload" ],
			"file": {
				"/tmp/restore-upload.tar.gz": [ "write" ]
			},
			"uci": [ "online-upgrade" ]
		}
	}
}
